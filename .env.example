# Change these to YOUR server paths. No personal infrastructure belongs in this file.
MEDIA_PATH=/path/to/media
CONFIG_PATH=./data
PUID=1000
PGID=1000
# Set your LAN address or 0.0.0.0 to expose the UI to your LAN and arr services.
CROWBARR_BIND=127.0.0.1
# Leave empty for a generated key in /config/admin-token.
CROWBARR_API_KEY=
CPU_LIMIT=2
MEMORY_LIMIT=4g
